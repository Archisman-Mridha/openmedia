{
	"connector.class": "io.debezium.connector.postgresql.PostgresConnector",
	"plugin.name": "pgoutput",

	"database.hostname": "postgres",
	"database.port": "5432",
	"database.user": "${env:POSTGRES_USER}",
	"database.password": "${env:POSTGRES_PASSWORD}",
	"database.dbname": "${env:POSTGRES_DB}",

	"slot.name": "openmedia_deleted_events",
	"publication.name": "openmedia_deleted_events",
	"publication.autocreate.mode": "filtered",

	"table.include.list": "public.followships",

	"skipped.operations": "c,u,t",
	"tombstones.on.delete": "false",
	"snapshot.mode": "no_data",

	"topic.prefix": "cdc.deleted",
	"transforms": "route",
	"transforms.route.type": "org.apache.kafka.connect.transforms.RegexRouter",
	"transforms.route.regex": "cdc\\.deleted\\.public\\.(.*)",
	"transforms.route.replacement": "events.$1.deleted"
}
