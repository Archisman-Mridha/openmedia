{
	"compileOnSave": false,
	"compilerOptions": {
		"declaration": false,
		"emitDecoratorMetadata": true,
		"experimentalDecorators": true,
		"importHelpers": true,
		"lib": ["es2020", "dom"],
		"module": "esnext",
		"moduleResolution": "bundler",
		"paths": {
			"@openmedia/backend/*": ["./backend/src/*"],
			"@openmedia/web/*": ["./frontend/web/*"],
			"@openmedia/packages/validators": ["./packages/validators/src/index.ts"]
		},
		"rootDir": ".",
		"skipDefaultLibCheck": true,
		"skipLibCheck": true,
		"sourceMap": true,
		"strictPropertyInitialization": false,
		"target": "es2015"
	},
	"exclude": ["node_modules"]
}
